endpoints = ["/login", "/produtos", "/pedidos"]
status = [
  [200, 200, 401, 200, 500],
  [200, 200, 200, 200, 200],
  [201, 500, 502, 201, 500]
]

def sucesso(num):
    return num >= 200 and num < 300

def checkSequencedError(table):
  for I in range(len(table)-1):
    current=table[I]
    next = table[I + 1]
    if not sucesso(current) and not sucesso(next):
      return True
    return False

def endpoint(table):
  success = 0
  total = len(table)
  
  for code in table:
    if sucesso(code):
      success += 1

  errors = total - success 
  fraction = (success / total)
  sequencedError = checkSequencedError(table)

  if sequencedError:
    result = "CRITÍCO"
  elif fraction >= 80:
    result = "ESTÁVEL"
  else:
    result = "INSTÁVEL"

  return (success, errors, fraction, result)

maxErrors = 0
maxErrorEndpoint = ""

for i in range(len(endpoints)):
  name = endpoints[i]
  data = status[i]

  success, errors, fraction, result = endpoint(data)

  print(f"Endpoint | {name}")
  print(f'Requisição | {data}')
  print(f"Sucesso | {success} ")
  print(f"Erros | {errors}")
  print(f"% de acertos | {fraction}")
  print(f"Classificação | {result}")
  print("-" * 30)

  if errors > maxErrors:
    maxErrors = errors
    maxErrorEndpoint = name
print(f"Endpoint com maior erro: {maxErrorEndpoint} | Errors : {maxErrors}")


  
  
